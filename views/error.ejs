<%_ /**
 @file views/error.ejs
 @author Anthony
 @date 2026-10-20
 @brief Affiche le message et les details d'une erreur serveur.
 **/ _%><!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Erreur</title>
</head>

<body>
    <h1>
        <%= message %>
    </h1>
    <h2>
        <%= error.status %>
    </h2>
    <pre><%= error.stack %></pre>
</body>

</html>