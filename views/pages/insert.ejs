<% /**
 @file views/pages/insert.ejs
 @author Anthony
 @date 2026-10-20
 @brief Affiche le formulaire d'ajout et la liste des pays.
 **/ %>
<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head') %>
</head>

<body>
    <%- include('../partials/header') %>

        <main>
            <h1>Ajouter un pays</h1>

            <form action="/insert" method="post">
                <div>
                    <label for="pays">Pays</label>
                    <input id="pays" name="Pays" type="text" pattern="[\p{L}\p{M} '-]+" required>
                </div>
                <div>
                    <label for="capitale">Capitale</label>
                    <input id="capitale" name="Capitale" type="text" pattern="[\p{L}\p{M} '-]+" required>
                </div>
                <div>
                    <label for="population">Population</label>
                    <input id="population" name="NbHab" type="number" min="0" step="1" required>
                </div>
                <div>
                    <label for="pib">PIB</label>
                    <input id="pib" name="PIB" type="number" min="0" step="any" required>
                </div>
                <div>
                    <label for="densite">Densité de population</label>
                    <input id="densite" name="DensitePop" type="number" min="0" step="any" required>
                </div>
                <div>
                    <label for="dejaVisite">Déjà visité</label>
                    <select id="dejaVisite" name="dejaVisite" required>
                        <option value="">Choisir une option</option>
                        <option value="O">Oui</option>
                        <option value="N">Non</option>
                    </select>
                </div>
                <div>
                    <label for="commentaires">Commentaires</label>
                    <textarea id="commentaires" name="Commentaires" rows="3"></textarea>
                </div>
                <input type="hidden" id="ID" name="ID" value="<%= prochainID %>">
                <button type="submit">Ajouter le pays</button>
            </form>

            <h2>Liste des pays du G20</h2>

            <table border="1">
                <tr>
                    <th>Pays</th>
                    <th>Capitale</th>
                    <th>Population</th>
                    <th>PIB</th>
                    <th>Densité de population</th>
                    <th>Déjà visité</th>
                    <th>Commentaires</th>
                </tr>

                <% pays.forEach(p=> { %>
                    <tr>
                        <td>
                            <%= p.Pays %>
                        </td>
                        <td>
                            <%= p.Capitale %>
                        </td>
                        <td>
                            <%= p.NbHab %>
                        </td>
                        <td>
                            <%= p.PIB %>
                        </td>
                        <td>
                            <%= p.DensitePop %>
                        </td>
                        <td>
                            <%= p.dejaVisite %>
                        </td>
                        <td>
                            <%= p.Commentaires %>
                        </td>
                    </tr>
                    <% }); %>
            </table>

        </main>

        <%- include('../partials/footer') %>
</body>

</html>