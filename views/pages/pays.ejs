
<%_ /**
 @file views/pages/pays.ejs
 @author Anthony
 @date 2026-10-20
 @brief Affiche sous forme de tableau les pays transmis par une route.
 **/ _%><!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head') %>
</head>

<body>
    <%- include('../partials/header') %>

        <main>
            <h1>Liste des pays du G20</h1>

            <table>
                <tr>
                    <th>Pays</th>
                    <th>Capitale</th>
                    <th>Population</th>
                    <th>PIB</th>
                    <th>Densité de population</th>
                    <th>Déjà visité</th>
                    <th>Commentaires</th>
                </tr>

                <% pays.forEach(p=> { %>
                    <tr>
                        <td>
                            <%= p.Pays %>
                        </td>
                        <td>
                            <%= p.Capitale %>
                        </td>
                        <td>
                            <%= p.NbHab %>
                        </td>
                        <td>
                            <%= p.PIB %>
                        </td>
                        <td>
                            <%= p.DensitePop %>
                        </td>
                        <td>
                            <%= p.dejaVisite %>
                        </td>
                        <td>
                            <%= p.Commentaires %>
                        </td>
                    </tr>
                    <% }); %>
            </table>
        </main>

        <%- include('../partials/footer') %>
</body>

</html>