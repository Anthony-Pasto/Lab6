
<% /**
 @file views/pages/delet.ejs
 @author Anthony
 @date 2026-10-20
 @brief Affiche le formulaire de suppression et la liste des pays.
 **/ %>
<!DOCTYPE html>
<html lang="fr">

<head>
    <%- include('../partials/head') %>
</head>

<body>
    <%- include('../partials/header') %>

    <main>
         <form action="/delete" method="post">
            <div>
                <label for="pays">Pays</label>
                <input id="pays" name="Pays" type="text" pattern="[\p{L}\p{M} '-]+" required>

            </div>
            <button type="submit">Supprimer le pays</button>


         </form>
        <h1>Liste des pays du G20</h1>

        <table border="1">
            <tr>
                <th>Pays</th>
                <th>Capitale</th>
                <th>Population</th>
                <th>PIB</th>
                <th>Densité de population</th>
                <th>Déjà visité</th>
                <th>Commentaires</th>
            </tr>

            <% pays.forEach(p => { %>
                <tr>
                    <td><%= p.Pays %></td>
                    <td><%= p.Capitale %></td>
                    <td><%= p.NbHab %></td>
                    <td><%= p.PIB %></td>
                    <td><%= p.DensitePop %></td>
                    <td><%= p.dejaVisite %></td>
                    <td><%= p.Commentaires %></td>
                </tr>
            <% }); %>
        </table>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
